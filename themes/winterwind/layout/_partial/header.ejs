<header id="header">
  <div id="banner" role="img" aria-label="Madeline 坐在 Celeste 山顶望向云海"></div>
  <div id="header-outer" class="outer">
    <div id="poem-line" class="poem-line" role="button" tabindex="0" aria-label="随机诗词，点击换一句">
      <span class="poem-text"></span>
      <span class="poem-from"></span>
    </div>
    <div id="header-inner" class="inner">
      <nav class="winter-nav" aria-label="主导航">
        <% for (var i in theme.menu){ %><a href="<%- url_for(theme.menu[i]) %>"><%= i %></a><% } %>
      <button class="nav-search-btn winter-search" type="button" aria-label="搜索">搜索</button>
      </nav>
      <div id="search-form-wrap" data-index="<%- url_for('search.json') %>">
        <div class="ww-search">
          <input type="search" class="ww-search-input" id="ww-search-input"
                 placeholder="搜索文章…" autocomplete="off" spellcheck="false"
                 aria-label="搜索文章" aria-expanded="false" aria-controls="ww-search-results">
          <button type="button" class="ww-search-close" aria-label="关闭搜索">×</button>
        </div>
        <div id="ww-search-results" class="ww-search-results" role="listbox" aria-label="搜索结果" hidden></div>
      </div>
    </div>
    <div id="header-title" class="inner">
      <h1 id="logo-wrap"><a href="<%- url_for() %>" id="logo">冬风的博客</a></h1>
      <% if (config.subtitle){ %><p id="subtitle-wrap"><span id="subtitle"><%= config.subtitle %></span></p><% } %>
    </div>
  </div>
</header>